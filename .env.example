# Local connection contract. Copy these names to the ignored .env.local file.
# Vercel Production must use supabase and the final HTTPS application origin.
BUSINESS_DATA_PROVIDER=supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Use only the Supabase publishable/anon key. Never use a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
