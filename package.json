{
  "name": "commerce-operations-saas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-deployment-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:universal:migrate": "node scripts/apply-universal-migrations.mjs",
    "db:legacy:migrate": "node scripts/migrate-legacy-workspace.mjs",
    "check:universal:pg-trgm": "node scripts/check-universal-pg-trgm-plan.mjs",
    "benchmark:universal:lists": "node scripts/benchmark-universal-lists.mjs",
    "import:dry-run": "node scripts/order-import-dry-run.mjs",
    "test:e2e": "npm run test:e2e:mock && npm run test:e2e:mock-controls && npm run test:e2e:auth",
    "test:e2e:mock": "playwright test --config playwright.config.ts",
    "test:e2e:mock-controls": "playwright test --config playwright.marketing.config.ts",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hookform/resolvers": "5.4.0",
    "@next/env": "16.4.5",
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.24.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "recharts": "3.9.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "29.1.1",
    "pg": "8.23.1",
    "shadcn": "4.13.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
